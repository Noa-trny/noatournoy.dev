{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/projets", "destination": "/travaux/", "permanent": true },
    { "source": "/projets/:path*", "destination": "/travaux/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/travaux/eclosion/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
